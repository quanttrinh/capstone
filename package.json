{
  "name": "capstone",
  "private": true,
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:format": "pnpm --filter web format",
    "web:format:check": "pnpm --filter web format:check",
    "web:test": "pnpm --filter web test",
    "api:dev": "uv run --directory apps/api fastapi dev src/capstone_api/main.py",
    "api:test": "uv run --directory apps/api pytest",
    "api:lint": "uv run --directory apps/api ruff check src/capstone_api",
    "api:typecheck": "uv run --directory apps/api mypy src/capstone_api",
    "api:check": "pnpm api:lint && pnpm api:typecheck"
  },
  "packageManager": "pnpm@12.4.2"
}